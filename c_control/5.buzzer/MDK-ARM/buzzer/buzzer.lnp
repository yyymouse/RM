"buzzer\stm32f4xx_hal_tim_ex.o"
"buzzer\stm32f4xx_hal_rcc.o"
"buzzer\stm32f4xx_hal_rcc_ex.o"
"buzzer\stm32f4xx_hal_flash.o"
"buzzer\stm32f4xx_hal_flash_ex.o"
"buzzer\stm32f4xx_hal_flash_ramfunc.o"
"buzzer\stm32f4xx_hal_gpio.o"
"buzzer\stm32f4xx_hal_dma_ex.o"
"buzzer\stm32f4xx_hal_dma.o"
"buzzer\stm32f4xx_hal_pwr.o"
